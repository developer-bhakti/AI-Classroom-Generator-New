# Adiuvaret AI Classroom Generator — Apache config
#
# Lives in public/ so `npm run build` copies it to dist/. Upload the CONTENTS of
# dist/ to your web root (public_html) — this file must sit next to index.html.

# ---------------------------------------------------------------
# Single-page app routing
# React Router owns /signup, /dashboard, /admin, etc. Apache has no such files,
# so without this a direct visit or refresh on any route returns 404.
# ---------------------------------------------------------------
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Uncomment to force HTTPS. Skip it if your host or CDN already redirects,
  # otherwise the two rules can fight and cause a redirect loop.
  # RewriteCond %{HTTPS} !=on
  # RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Serve real files and directories as-is (assets, favicon, robots.txt...).
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else hands off to the app.
  RewriteRule . /index.html [L]
</IfModule>

# ---------------------------------------------------------------
# Caching
# Vite fingerprints asset filenames (index-A1b2C3.js), so they can be cached
# hard. index.html must NOT be cached, or returning visitors keep booting the
# old build and pointing at asset files that no longer exist after a deploy.
# ---------------------------------------------------------------
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
    Header set Pragma "no-cache"
  </FilesMatch>

  <FilesMatch "\.(js|css|woff2?|ttf|otf|eot|svg|png|jpe?g|gif|webp|avif|ico)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # Modest hardening. No CSP here — it needs tuning against Razorpay's
  # checkout frame and the Supabase/Gemini endpoints.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

# ---------------------------------------------------------------
# Compression
# ---------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

# ---------------------------------------------------------------
# Correct MIME types (some shared hosts still miss these)
# ---------------------------------------------------------------
<IfModule mod_mime.c>
  AddType application/javascript .js .mjs
  AddType image/svg+xml .svg
  AddType font/woff2 .woff2
  AddType application/manifest+json .webmanifest
</IfModule>

# Never serve the env file, even if one is uploaded by mistake.
# mod_authz_core only exists on Apache 2.4; the 2.2 syntax differs and would
# 500 there, so each is gated on the module that understands it.
<IfModule mod_authz_core.c>
  <FilesMatch "^\.env">
    Require all denied
  </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
  <FilesMatch "^\.env">
    Order allow,deny
    Deny from all
  </FilesMatch>
</IfModule>

# Directory listings off. If your host forbids Options in .htaccess this line
# causes a 500 — it is the first thing to delete when troubleshooting.
Options -Indexes
