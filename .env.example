# Get a key from https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=

# Optional — defaults to gemini-flash-latest
# VITE_GEMINI_MODEL=gemini-flash-latest

# Optional — model used for generated worksheet images. Defaults to gemini-3.1-flash-image.
# NOTE: Gemini image models are NOT on the free tier (free-tier quota is 0). The key above
# must have billing enabled on its Google Cloud project or image generation returns 429.
# VITE_GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# Supabase — Project Settings -> API
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay — Dashboard -> Account & Settings -> API Keys
# Only the Key ID belongs here. The Key Secret must NEVER be in this file:
# it is set as a Supabase Edge Function secret instead (see supabase/README.md).
VITE_RAZORPAY_KEY_ID=
